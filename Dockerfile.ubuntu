FROM ubuntu:22.04 AS build

# Build against Ubuntu 22.04's glibc so the binary can also run on newer Ubuntu
# desktops. Rust, compilers, and development headers stay in this build stage.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential pkg-config curl ca-certificates libasound2-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
ARG RUST_TOOLCHAIN=stable
RUN curl --proto '=https' --tlsv1.2 --fail --show-error --silent \
        https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal \
        --default-toolchain "$RUST_TOOLCHAIN" --no-modify-path \
    && rm /tmp/rustup-init.sh

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
ARG BUILD_JOBS=2
RUN cargo build --locked --release --bin hearing_test --jobs "$BUILD_JOBS" \
    && strip --strip-unneeded target/release/hearing_test

# Export only the executable, without a container or Rust installation.
FROM scratch AS binary
COPY --from=build /app/target/release/hearing_test /hearing-test

# Packaging tools and runtime libraries are installed only on the build
# machine. Include libraries loaded through dlopen as well as ELF dependencies.
FROM build AS bundle
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 makeself libasound2-plugins pulseaudio-utils \
        libx11-xcb1 libxcursor1 libxi6 libxrandr2 libxrender1 \
        libxcb-shape0 libxcb-xfixes0 libxcb-render0 libxkbcommon-x11-0 \
        libwayland-client0 libwayland-cursor0 libwayland-egl1 \
        libvulkan1 mesa-vulkan-drivers libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
COPY packaging ./packaging
RUN python3 packaging/bundle-ubuntu.py \
    && mkdir -p /out \
    && makeself --nox11 --sha256 --quiet /bundle \
        /out/hearing-test-ubuntu-x86_64.run "Hearing Tracker" ./AppRun

# A FUSE-free self-extracting launcher: nothing is installed system-wide.
FROM scratch AS portable
COPY --from=bundle /out/hearing-test-ubuntu-x86_64.run /
