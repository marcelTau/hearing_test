#!/bin/sh
set -eu

bundle_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export LD_LIBRARY_PATH="$bundle_dir/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$bundle_dir/bin:$PATH"
export ALSA_CONFIG_DIR="$bundle_dir/share/alsa"
export ALSA_CONFIG_PATH="$ALSA_CONFIG_DIR/alsa.conf"
export ALSA_PLUGIN_DIR="$bundle_dir/lib/alsa-lib"
export XKB_CONFIG_ROOT="$bundle_dir/share/X11/xkb"
export XLOCALEDIR="$bundle_dir/share/X11/locale"

# Use the included software Vulkan driver. This also works when the machine
# has no suitable GPU driver, and keeps the bundle independent of driver ABIs.
export VK_ICD_FILENAMES="$bundle_dir/share/vulkan/icd.d/lvp.json"
export VK_DRIVER_FILES="$VK_ICD_FILENAMES"

exec "$bundle_dir/bin/hearing-test" "$@"
